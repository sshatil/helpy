{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helpy",
  "version": "0.1.0",
  "identifier": "com.mutasimshatil.helpy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Helpy",
        "width": 1300,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["helpy"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1OUVFRkU4RDhDREUzODMKUldTRDQ4M1k2TytlNVRObXUzRjh0VmtqN1FoZUJjYTFjQVpIUGxOVStPRnpLd3FjSVhRaVRHQm0K",
      "endpoints": [
        "https://github.com/sshatil/helpy/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  }
}
